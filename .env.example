# Copy to .env for local use. Never commit real values.

# --- Browser-safe (Vite exposes only VITE_* to the browser) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=public-anon-key
VITE_API_BASE_URL=https://YOUR-API.vercel.app

# --- Server-only (FastAPI on Vercel, worker in GitHub Actions) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-never-in-browser
SUPABASE_JWT_SECRET=server-only
# Use the Supabase *Session pooler* string (IPv4). The direct db.<ref>.supabase.co host is IPv6-only and
# GitHub-hosted runners cannot reach it.
DATABASE_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
ALLOWED_ORIGINS=https://YOUR-WEB.vercel.app
GITHUB_DISPATCH_TOKEN=server-only-fine-grained-token-actions-write

# --- Tests only ---
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
