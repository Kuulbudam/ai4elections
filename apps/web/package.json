{
  "name": "@ai4elections/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview",
    "gen:types": "openapi-typescript ../../packages/contracts/openapi.yaml -o src/api/schema.d.ts",
    "gen:types:check": "openapi-typescript ../../packages/contracts/openapi.yaml -o /tmp/ai4e-schema.d.ts && diff -q /tmp/ai4e-schema.d.ts src/api/schema.d.ts && echo \"TypeScript types match openapi.yaml\""
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "@supabase/supabase-js": "^2.119.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
